<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/eko_bg">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="56dp"
            android:paddingBottom="24dp">

            <!-- ══ Header ══ -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EKO MEDIA"
                android:textColor="@color/eko_text"
                android:textSize="28sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="0.15" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="by AKRO • Download Engine"
                android:textColor="@color/eko_accent"
                android:textSize="12sp"
                android:layout_marginBottom="24dp" />

            <!-- ══ URL Input Card ══ -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/eko_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="VIDEO URL"
                        android:textColor="@color/eko_accent"
                        android:textSize="10sp"
                        android:letterSpacing="0.2"
                        android:layout_marginBottom="8dp" />

                    <EditText
                        android:id="@+id/etUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="@string/hint_url"
                        android:textColor="@color/eko_text"
                        android:textColorHint="@color/eko_text_dim"
                        android:textSize="14sp"
                        android:background="@drawable/input_bg"
                        android:padding="12dp"
                        android:imeOptions="actionSearch"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:layout_marginBottom="12dp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <Button
                            android:id="@+id/btnPaste"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="PASTE"
                            android:textSize="11sp"
                            android:textColor="@color/eko_text_dim"
                            android:backgroundTint="@color/eko_surface2"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />

                        <Button
                            android:id="@+id/btnClear"
                            android:layout_width="wrap_content"
                            android:layout_height="40dp"
                            android:text="CLEAR"
                            android:textSize="11sp"
                            android:textColor="@color/eko_text_dim"
                            android:backgroundTint="@color/eko_surface2"
                            android:layout_marginEnd="8dp"
                            style="@style/Widget.MaterialComponents.Button.TextButton" />

                        <Button
                            android:id="@+id/btnFetch"
                            android:layout_width="100dp"
                            android:layout_height="40dp"
                            android:text="FETCH"
                            android:textSize="12sp"
                            android:textColor="@color/eko_bg"
                            android:backgroundTint="@color/eko_accent" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ Loading Card ══ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/eko_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="24dp"
                    android:gravity="center">

                    <ProgressBar
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:indeterminateTint="@color/eko_accent" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Extracting video info…"
                        android:textColor="@color/eko_text_dim"
                        android:textSize="13sp"
                        android:layout_marginTop="12dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ Error Card ══ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/eko_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <TextView
                        android:id="@+id/tvError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/eko_error"
                        android:textSize="14sp"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnRetry"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:text="RETRY"
                        android:textSize="11sp"
                        android:textColor="@color/eko_bg"
                        android:backgroundTint="@color/eko_accent" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ Video Info Card ══ -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                app:cardBackgroundColor="@color/eko_surface"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Thumbnail -->
                    <ImageView
                        android:id="@+id/ivThumbnail"
                        android:layout_width="match_parent"
                        android:layout_height="200dp"
                        android:scaleType="centerCrop"
                        android:background="@color/eko_surface2"
                        android:layout_marginBottom="12dp" />

                    <!-- Platform badge -->
                    <TextView
                        android:id="@+id/tvPlatform"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YouTube"
                        android:textColor="@color/white"
                        android:textSize="10sp"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="3dp"
                        android:layout_marginBottom="8dp" />

                    <!-- Title -->
                    <TextView
                        android:id="@+id/tvVideoTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/eko_text"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="2"
                        android:ellipsize="end"
                        android:layout_marginBottom="6dp" />

                    <!-- Author + Duration row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="16dp">

                        <TextView
                            android:id="@+id/tvAuthor"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text=""
                            android:textColor="@color/eko_text_dim"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/eko_accent"
                            android:textSize="12sp" />

                    </LinearLayout>

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/btnPlayInApp"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="▶ PLAY"
                            android:textColor="@color/eko_accent"
                            android:backgroundTint="@color/eko_surface2"
                            android:layout_marginEnd="8dp" />

                        <Button
                            android:id="@+id/btnDownload"
                            android:layout_width="0dp"
                            android:layout_height="48dp"
                            android:layout_weight="1"
                            android:text="⬇ DOWNLOAD"
                            android:textColor="@color/eko_bg"
                            android:backgroundTint="@color/eko_accent" />

                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- ══ Downloads Header ══ -->
            <TextView
                android:id="@+id/tvDownloadsHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DOWNLOADS"
                android:textColor="@color/eko_text_dim"
                android:textSize="10sp"
                android:letterSpacing="0.2"
                android:visibility="gone"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp" />

            <!-- ══ Downloads RecyclerView ══ -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvDownloads"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
